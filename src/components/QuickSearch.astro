---
import Icon from './Icon.astro';
---
<form class="quick-search" action="/book/" method="get" aria-label="Find your stay">
  <label><span>YOUR ARRIVAL</span><input type="date" name="checkIn" aria-label="Check-in date" required /></label>
  <label><span>YOUR DEPARTURE</span><input type="date" name="checkOut" aria-label="Check-out date" required /></label>
  <label><span>GOOD COMPANY</span><select name="guests" aria-label="Number of guests"><option value="2">2 guests</option><option value="1">1 guest</option><option value="3">3 guests</option><option value="4">4 guests</option><option value="5">5 guests · two apartments</option><option value="6">6 guests · two apartments</option><option value="7">7 guests · two apartments</option><option value="8">8 guests · two apartments</option></select></label>
  <button class="button" type="submit">Find my stay <Icon name="arrow" size={19}/></button>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('.quick-search');
  if (form) {
    const arrival = form.querySelector<HTMLInputElement>('[name=checkIn]')!;
    const departure = form.querySelector<HTMLInputElement>('[name=checkOut]')!;
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Bangkok', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    arrival.min = today;
    arrival.addEventListener('change', () => {
      if (!arrival.value) { departure.min = today; return; }
      const next = new Date(`${arrival.value}T12:00:00Z`);
      if (Number.isNaN(next.getTime())) return;
      next.setUTCDate(next.getUTCDate() + 2);
      departure.min = next.toISOString().slice(0, 10);
      if (departure.value < departure.min) departure.value = '';
    });
  }
</script>
