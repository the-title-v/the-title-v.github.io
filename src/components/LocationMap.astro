---
import Icon from './Icon.astro';
import { residenceLocation } from '../data/location';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class:list={['location-map', { compact }]}>
  <iframe
    src={residenceLocation.embedUrl}
    title="Map showing The Title V condominium at 555 Wiset Road in Rawai, Phuket"
    width="1200" height="540" loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
  <div class="map-caption">
    <div><span class="eyebrow">YOUR RAWAI BASE</span><h3>{residenceLocation.name}</h3><p>{residenceLocation.address}</p></div>
    <div class="map-actions"><a class="text-link" href={residenceLocation.mapsUrl} target="_blank" rel="noopener noreferrer">Open map <Icon name="arrow" size={15}/></a><a class="button" href={residenceLocation.directionsUrl} target="_blank" rel="noopener noreferrer">Directions <Icon name="arrow" size={16}/></a><a class="text-link" href="/guides/phuket-airport-to-rawai/">Getting here <Icon name="arrow" size={15}/></a></div>
  </div>
</div>
<style>
  .location-map{background:var(--sage);border:1px solid var(--line)}
  iframe{display:block;width:100%;height:520px;border:0;background:var(--sage)}
  .compact iframe{height:380px}
  .map-caption{display:flex;align-items:center;justify-content:space-between;gap:32px;padding:27px 32px}
  .map-caption .eyebrow{display:block;margin-bottom:8px;font-size:8px}
  h3{font-size:29px;margin-bottom:7px}
  p{font-size:11px;line-height:1.7;color:var(--muted);margin:0;max-width:450px}
  .map-actions{display:flex;align-items:center;gap:26px;flex-shrink:0}
  .map-actions .button{font-size:11px;padding:13px 18px;gap:18px}
  @media(max-width:900px){.map-caption{align-items:flex-start;flex-direction:column;gap:18px}.map-actions{flex-wrap:wrap}}
  @media(max-width:600px){iframe{height:400px}.compact iframe{height:320px}.map-caption{padding:23px}.map-actions{gap:18px}.map-actions .text-link{font-size:11px}h3{font-size:26px}}
</style>
