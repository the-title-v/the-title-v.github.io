---
import registrations from '../data/web-analytics.json';
import { selectWebAnalytics, webAnalyticsLoader } from '../lib/web-analytics';

const deployment = new URL(process.env.SITE_URL || Astro.site!.href);
const analytics = selectWebAnalytics(deployment, registrations, import.meta.env.PROD);
---
{analytics && <script is:inline data-web-analytics set:html={webAnalyticsLoader(analytics)} />}
