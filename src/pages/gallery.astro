---
import Layout from '../layouts/Layout.astro';
import { properties, images } from '../data/properties';
const groups = [
  { name: 'Bright apartment', href: `/stays/${properties[0].slug}/`, linkLabel: 'Explore Bright', photos: properties[0].gallery.slice(0, 6) },
  { name: 'Cozy apartment', href: `/stays/${properties[1].slug}/`, linkLabel: 'Explore Cozy', photos: properties[1].gallery.slice(0, 8) },
  { name: 'Shared pools, gardens and facilities', href: '/residence/', linkLabel: 'Explore the shared residence', photos: [images.poolCourtyard, images.centralPool, images.gardenWalkway, images.coworking, images.gym] },
  { name: 'The Rawai waterfront', href: '/location/', linkLabel: 'See the map and nearby places', photos: [images.rawai] },
];
---
<Layout title="Photos of our apartments and The Title V residence" seoTitle={"The Title V Rawai Photos | Apartments & Shared Pools"} description="See real photos of Bright and Cozy at The Title V in Rawai: bedrooms, kitchens, balconies, shared pools and gardens.">
  <section class="page-intro container"><p class="eyebrow">A CLOSER LOOK AT YOUR LITTLE ESCAPE</p><h1>Photos of our apartments and The Title V residence</h1><p class="lede">Explore the real apartments and the shared residence facilities before choosing your stay.</p></section>{groups.map(group => <section class="container content-section"><h2 style="font-size:38px;max-width:700px">{group.name}</h2><a class="text-link gallery-link" href={group.href}>{group.linkLabel}</a><div class="apartment-gallery">{group.photos.map(photo => <figure><a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`View full photo: ${photo.alt}`}><img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy"/></a><figcaption>{photo.caption || photo.alt}</figcaption></figure>)}</div></section>)}
  <div class="container content-section"><a class="button" href="/book/">Check dates at The Title V</a></div>
</Layout>
<style>.gallery-link{margin-bottom:24px}</style>
