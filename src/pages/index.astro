---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PropertyCard from '../components/PropertyCard.astro';
import QuickSearch from '../components/QuickSearch.astro';
import { properties } from '../data/properties';
import { guides } from '../data/guides';
---
<Layout title="Your place in Rawai" description="Slow mornings, tropical pools and a place of your own. Discover the apartments at The Title V in Rawai, Phuket. Check availability and book directly.">
  <section class="home-hero">
    <img class="hero-image" src="/images/pool-courtyard.webp" width="1920" height="1440" alt="A turquoise swimming pool framed by tropical gardens at The Title V, Rawai" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-content"><p class="eyebrow"><span class="tiny-line"></span> YOUR PLACE IN RAWAI, PHUKET</p><h1>A little escape.<br />A place to <em>belong.</em></h1><p>Slow mornings. Barefoot afternoons.<br />The comfort of your own home in Phuket.</p><a class="hero-link" href="/stays/">Discover your apartment <Icon name="right" size={22}/></a></div>
    <div class="hero-caption"><span>THE TITLE V · THAILAND</span><span>8° NORTH. A WORLD AWAY.</span></div>
  </section>
  <div class="search-wrap"><QuickSearch /><p class="search-note"><Icon name="check" size={14}/> Book a little more personally. Speak directly with your host.</p></div>
  <section class="intro section container" data-reveal><p class="eyebrow">A DIFFERENT KIND OF PHUKET STAY</p><h2>All the ease of a holiday.<br /><em>All the feeling of home.</em></h2><p>Tucked into the tropical gardens of The Title V, our two one-bedroom apartments put you close to Rawai’s waterfront and the everyday pleasures of southern Phuket. Settle in for a few nights. Stay long enough to find your favourite coffee.</p><div class="intro-facts"><span><Icon name="pool"/> Five shared pools</span><span><Icon name="home"/> Your own kitchen</span><span><Icon name="wifi"/> Wi-Fi & workspace</span><span><Icon name="leaf"/> Tropical garden setting</span></div></section>
  <section class="section apartments-section container"><div class="section-heading" data-reveal><div><p class="eyebrow">TWO APARTMENTS. YOUR OWN LITTLE WORLD.</p><h2>Find your <em>kind of stay.</em></h2></div><a class="text-link" href="/stays/">Explore all stays <Icon name="arrow" size={18}/></a></div><div class="property-grid">{properties.slice(0, 2).map((property, index) => <PropertyCard property={property} index={index}/>)}</div><a class="together-strip" href="/stays/two-adjacent-apartments-title-v-rawai/"><span><Icon name="home"/> Travelling with your favourite people?</span><span>Book the two adjacent apartments together <Icon name="arrow" size={18}/></span></a></section>
  <section class="slow-section"><div class="slow-image"><img src="/images/central-pool.webp" alt="Poolside loungers and leafy gardens at The Title V" width="1920" height="1393" loading="lazy" /></div><div class="slow-copy" data-reveal><p class="eyebrow">LESS RUSH. MORE RAWAI.</p><h2>Make room for<br />the <em>little things.</em></h2><p>A quiet swim before breakfast. Lunch by the waterfront. An afternoon with nowhere you need to be. This is your invitation to settle into the south of the island.</p><div class="small-feature"><Icon name="sun" size={27}/><div><h3>Days at your own pace</h3><p>Pools, tropical paths, a gym and the simple pleasure of coming home.</p></div></div><div class="small-feature"><Icon name="pin" size={27}/><div><h3>A neighbourhood to discover</h3><p>Rawai’s waterfront nearby, with Nai Harn and the southern coast to explore.</p></div></div><a class="text-link" href="/location/">Get to know the neighbourhood <Icon name="arrow" size={18}/></a></div></section>
  <section class="section container direct-section" data-reveal><div><p class="eyebrow">A REAL HOME. A REAL PERSON.</p><h2>Your stay,<br /><em>with a personal touch.</em></h2><a class="text-link" href="/about/">Meet your host <Icon name="arrow" size={18}/></a></div><div class="direct-benefits"><div><span>01</span><h3>Straight to your host</h3><p>Ask a question, share your plans, and arrange your stay directly with your host.</p></div><div><span>02</span><h3>Stay longer, settle in</h3><p>Automatic weekly and monthly discounts, with a clear estimate before you enquire.</p></div><div><span>03</span><h3>A little more peace of mind</h3><p>See the apartments on Airbnb too. Agree on all the details before confirming your stay.</p></div></div></section>
  <section class="journal-section section"><div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">NOTES FROM THE NEIGHBOURHOOD</p><h2>A little local <em>inspiration.</em></h2></div><a class="text-link" href="/guides/">The Rawai journal <Icon name="arrow" size={18}/></a></div><div class="guide-grid">{[guides[0], guides[7], guides[2]].map(guide => <article class="guide-card" data-reveal><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy" /></a><p class="eyebrow">{guide.eyebrow}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><a class="text-link" href={`/guides/${guide.slug}/`}>Take a look <Icon name="arrow" size={16}/></a></article>)}</div></div></section>
</Layout>
