---
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/site';
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<Layout title="Questions about booking and staying at The Title V" seoTitle={"The Title V Direct Booking FAQ | Stays & Costs"} description="Find answers about direct booking, the seven-night minimum, guest limits, cleaning, deposits, utilities and longer stays at The Title V in Rawai." schema={schema}>
  <section class="page-intro container"><p class="eyebrow">THE LITTLE THINGS, EXPLAINED</p><h1>Questions about booking and staying at The Title V</h1><p class="lede">Here are the practical details to check before requesting your stay. Our booking team confirms your dates, final price and payment terms with you.</p></section><section class="container content-section"><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div><p class="faq-next"><a href="/book/">Check dates and prices</a> · <a href="/rates/">Rates and charges</a> · <a href="/booking-terms/">Full booking terms</a> · <a href="/location/">Find The Title V</a></p></section>
</Layout>
<style>.faq-next{margin-top:32px;line-height:2}.faq-next a{text-decoration:underline;text-underline-offset:3px}</style>
