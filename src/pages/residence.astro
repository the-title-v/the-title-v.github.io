---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { images } from '../data/properties';
import { localSources } from '../data/location';
const facilities = [
  { title: 'A swim before breakfast', image: images.centralPool, text: 'Shared pools wind through the residence, with loungers and planted courtyards around them. Make room for an easy afternoon close to your apartment.', note: 'Follow the posted pool hours and residence rules.' },
  { title: 'Room to keep your routine', image: images.gym, text: 'The shared fitness room gives you an option for a workout without an extra journey. The sauna and steam-room area offer another way to wind down.', note: 'The gym is modest in scale. Current equipment and opening hours may vary.' },
  { title: 'A change of workspace', image: images.coworking, text: 'Bring a laptop to the shared coworking area when you want a different setting. Your apartment also has its own desk and internet connection.', note: 'Shared seating is not a reserved private office.' },
  { title: 'Little explorers welcome', image: images.childrensPool, text: 'A children’s pool and a small outdoor playground make it easy to fit play into the day, with your own kitchen and bedroom nearby for the next break.', note: 'Children need adult supervision. No lifeguard or childcare service is promised.' },
];
---
<Layout title="The residence" description="Explore The Title V residence in Rawai: shared pools, landscaped gardens, gym, sauna, steam room, coworking space, children’s pool and playground, with authentic photos." image={images.poolCourtyard.src}>
  <section class="residence-hero">
    <img src={images.poolCourtyard.src} alt={images.poolCourtyard.alt} width={images.poolCourtyard.width} height={images.poolCourtyard.height} fetchpriority="high"/>
    <div class="residence-shade"></div>
    <div class="container residence-hero-copy"><p class="eyebrow">THE RESIDENCE · RAWAI, PHUKET</p><h1>The Title V<span>.</span></h1><p>Leafy courtyards, a choice of pools,<br />and space to settle into your own routine.</p><a href="#grounds" class="hero-link">Take a look around <Icon name="arrow" size={16}/></a></div>
    <p class="residence-hero-caption">SHARED POOL COURTYARD AT THE TITLE V · ACTUAL RESIDENCE PHOTOGRAPH</p>
  </section>

  <section class="container section residence-intro" id="grounds" data-reveal><div><p class="eyebrow">YOUR APARTMENT, WITH A LITTLE MORE AROUND IT</p><h2>Come home<br /><em>to the green.</em></h2></div><div><p>The Title V is a low-rise condominium set back from Rawai’s waterfront. Garden paths connect the buildings and pools, making the shared grounds part of everyday life here.</p><p>Stay in your own one-bedroom apartment and use the residence’s shared facilities during their opening hours. The photographs on this page show the actual complex from our apartment listing galleries.</p><a class="text-link" href="/location/">Explore the neighborhood <Icon name="arrow" size={15}/></a></div></section>

  <section class="container residence-facilities" aria-label="Residence amenities">{facilities.map((facility, index) => <article class:list={['facility', { reverse: index % 2 !== 0 }]} data-reveal><figure><img src={facility.image.src} alt={facility.image.alt} width={facility.image.width} height={facility.image.height} loading="lazy"/></figure><div class="facility-copy"><span class="facility-number">0{index + 1}</span><h2>{facility.title}</h2><p>{facility.text}</p><p class="facility-note">{facility.note}</p></div></article>)}</section>

  <section class="residence-details section"><div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">THE DETAILS BETWEEN THE BIG MOMENTS</p><h2>Gardens, shade<br /><em>and familiar routines.</em></h2></div><p>A few more views of the spaces you will share with other residents.</p></div><div class="residence-photo-grid"><figure><img src={images.gardenWalkway.src} alt={images.gardenWalkway.alt} width={images.gardenWalkway.width} height={images.gardenWalkway.height} loading="lazy"/><figcaption>Garden paths between the buildings and pools.</figcaption></figure><figure><img src={images.sauna.src} alt={images.sauna.alt} width={images.sauna.width} height={images.sauna.height} loading="lazy"/><figcaption>The shared sauna and steam-room area.</figcaption></figure><figure><img src={images.playground.src} alt={images.playground.alt} width={images.playground.width} height={images.playground.height} loading="lazy"/><figcaption>A small outdoor playground in the residence.</figcaption></figure></div></div></section>

  <section class="container section residence-practical" data-reveal><div><p class="eyebrow">GOOD TO KNOW BEFORE YOU ARRIVE</p><h2>The practical<br /><em>comforts.</em></h2><img src={images.entrance.src} alt={images.entrance.alt} width={images.entrance.width} height={images.entrance.height} loading="lazy"/></div><dl><div><dt>Parking</dt><dd>The complex has shared parking. Let the booking team know if you will bring a car or motorbike so arrival and parking instructions can be confirmed.</dd></div><div><dt>Security</dt><dd>The residence is listed with 24-hour security and CCTV in common areas. Keep your entry details with you and follow the building’s visitor arrangements.</dd></div><div><dt>Elevator access</dt><dd>Both apartments are on the second floor and have elevator access. For a stroller, wheelchair or specific mobility need, ask the team to check the full access route and relevant dimensions.</dd></div><div><dt>A local welcome</dt><dd>A local agent meets and greets guests. Share your arrival plans with the booking team so your meeting point and check-in details are ready before you travel.</dd></div><div><dt>Shared facilities</dt><dd>Pools, gym, sauna, steam room and coworking areas are shared with other residents. Follow posted hours; maintenance and residence rules can affect access.</dd></div></dl></section>

  <section class="container residence-stays" data-reveal><div><p class="eyebrow">CHOOSE YOUR OWN CORNER</p><h2>Two apartments.<br /><em>The same lovely setting.</em></h2><p>Bright and Cozy each have a queen bedroom, a living room with a sofa bed, a kitchen, a washer and a balcony. Each accommodates up to two adults and two children aged 14 or younger.</p><a href="/stays/" class="button">Explore the apartments <Icon name="arrow" size={17}/></a><a href="/stays/two-adjacent-apartments-title-v-rawai/" class="text-link">Traveling together? Book both <Icon name="arrow" size={14}/></a></div><div class="apartment-pair"><img src={images.brightLiving.src} alt={images.brightLiving.alt} width={images.brightLiving.width} height={images.brightLiving.height} loading="lazy"/><img src={images.cozyLiving.src} alt={images.cozyLiving.alt} width={images.cozyLiving.width} height={images.cozyLiving.height} loading="lazy"/></div></section>
  <div class="container residence-sources"><span>Residence details: </span><a href="https://www.airbnb.com/rooms/622135535519576635" target="_blank" rel="noopener noreferrer">apartment listing and photo gallery</a><span> · </span><a href={localSources.residence.url} target="_blank" rel="noopener noreferrer">The Title V project information</a><span>. Reviewed 22 October 2026.</span></div>
</Layout>
<style>
  .residence-hero{position:relative;height:580px;max-height:calc(100svh - 98px);min-height:440px;overflow:hidden;color:white}
  .residence-hero>img{height:100%;object-fit:cover;object-position:50% 58%;animation:hero-arrive 1.3s ease-out both}
  .residence-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,29,23,.63),rgba(8,29,23,.07) 85%),linear-gradient(0deg,rgba(8,29,23,.38),transparent 35%)}
  .residence-hero-copy{position:absolute;inset:0;padding-top:90px;animation:content-arrive .9s ease-out both}
  .residence-hero-copy h1{font-size:clamp(68px,8.4vw,116px);line-height:1;margin-bottom:24px}.residence-hero-copy h1 span{color:#d1ddbf}
  .residence-hero-copy>p:not(.eyebrow){font-size:14px;line-height:1.9;margin-bottom:25px}
  .residence-hero-caption{position:absolute;bottom:24px;left:max(56px,calc((100vw - 1200px)/2));font-size:8px;letter-spacing:.13em;margin:0}
  .residence-intro{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:start}.residence-intro p:not(.eyebrow){font-size:13px;color:var(--muted);max-width:470px}.residence-intro h2{margin-bottom:0}
  .residence-facilities{padding-bottom:90px}.facility{display:grid;grid-template-columns:1.3fr 1fr;align-items:center;margin-bottom:55px;gap:80px}.facility:last-child{margin-bottom:0}.facility.reverse{grid-template-columns:1fr 1.3fr}.facility.reverse figure{order:2}.facility figure{margin:0;overflow:hidden}.facility img{aspect-ratio:1.3;object-fit:cover;transition:transform .7s}.facility figure:hover img{transform:scale(1.025)}.facility-number{font-family:var(--serif);font-size:25px;color:#8b9d82;display:block;margin-bottom:18px}.facility-copy h2{font-size:clamp(36px,3.5vw,48px);max-width:310px;margin-bottom:23px}.facility-copy p{font-size:13px;color:var(--muted);max-width:365px}.facility-copy .facility-note{font-size:10px;line-height:1.9;border-top:1px solid var(--line);padding-top:17px;margin-top:24px;max-width:330px}
  .residence-details{background:var(--sage)}.residence-details .section-heading>p{font-size:13px;color:var(--muted);max-width:270px;margin-bottom:0}.residence-photo-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:27px}.residence-photo-grid figure{margin:0}.residence-photo-grid img{aspect-ratio:1;object-fit:cover}.residence-photo-grid figcaption{font-size:10px;color:var(--muted);margin-top:14px}
  .residence-practical{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:start}.residence-practical img{aspect-ratio:1.25;object-fit:cover;margin-top:34px}.residence-practical dl{margin:0;padding-top:5px}.residence-practical dl>div{padding:21px 0;border-bottom:1px solid var(--line)}.residence-practical dl>div:first-child{padding-top:0}.residence-practical dt{font-family:var(--serif);font-size:29px;line-height:1.1;margin-bottom:12px}.residence-practical dd{font-size:12px;color:var(--muted);margin:0;line-height:1.9}
  .residence-stays{display:grid;grid-template-columns:1fr 1.1fr;gap:95px;align-items:center;border-top:1px solid var(--line);padding-block:75px}.residence-stays p:not(.eyebrow){font-size:13px;color:var(--muted);max-width:420px}.residence-stays .button{margin-top:10px}.residence-stays .text-link{display:flex;width:fit-content;margin-top:20px}.apartment-pair{display:grid;grid-template-columns:1fr 1fr;gap:15px;align-items:start}.apartment-pair img{aspect-ratio:.7;object-fit:cover}.apartment-pair img:nth-child(2){margin-top:50px}
  .residence-sources{font-size:10px;color:var(--muted);padding-bottom:44px;line-height:1.9}.residence-sources a{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:760px){.residence-details .section-heading{flex-direction:column;align-items:flex-start;gap:24px}.residence-details .section-heading>p{max-width:100%}}
  @media(max-width:1000px){.facility{gap:45px}.residence-intro,.residence-practical{gap:55px}.residence-stays{gap:50px}}
  @media(max-width:760px){.residence-hero{height:calc(100svh - 78px);max-height:560px;min-height:440px}.residence-hero-copy{padding-top:65px}.residence-hero-copy h1{font-size:68px}.residence-hero-copy>p:not(.eyebrow){font-size:12px}.residence-hero-caption{left:24px;right:24px;font-size:7px}.residence-intro,.facility,.facility.reverse,.residence-practical,.residence-stays{grid-template-columns:1fr;gap:28px}.residence-intro{gap:25px}.residence-intro p:not(.eyebrow){max-width:100%}.facility{margin-bottom:50px}.facility.reverse figure{order:0}.facility img{aspect-ratio:1.3}.facility-copy h2{max-width:none;font-size:38px}.facility-number{margin-bottom:10px}.facility-copy p,.facility-copy .facility-note{max-width:none}.residence-facilities{padding-bottom:55px}.residence-photo-grid{grid-template-columns:1fr;gap:30px}.residence-photo-grid img{aspect-ratio:1.4}.residence-photo-grid figcaption{margin-top:10px}.residence-practical img{margin-top:25px}.residence-practical dl{padding-top:10px}.residence-stays{padding-block:50px}.residence-stays p:not(.eyebrow){max-width:none}.apartment-pair img{aspect-ratio:.9}.apartment-pair img:nth-child(2){margin-top:25px}}
</style>
