---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { properties } from '../data/properties';
import { reviewListings, REVIEWS_CHECKED_AT } from '../data/reviews';

const apartments = reviewListings.map(listing => ({
  listing,
  photo: properties.find(property => property.slug === listing.propertyId)!.hero,
}));
const checkedDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${REVIEWS_CHECKED_AT}T00:00:00Z`));
const reviewMonth = (month: string) => new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${month}-01T00:00:00Z`));
---
<Layout title="Guest reviews" description="Selected Airbnb guest highlights from our Bright and Cozy apartments at The Title V, with each apartment’s rating and links to the full reviews." image={apartments[0].photo.src}>
  <section class="page-intro container review-intro">
    <p class="eyebrow">GUEST REVIEWS</p>
    <h1>A few words<br /><em>from our guests.</em></h1>
    <p class="lede">Selected guest highlights from Airbnb.</p>
    <p class="selection-note">Excerpts · names abbreviated · Airbnb translations noted</p>
  </section>

  <div class="container review-apartments">
    {apartments.map(({ listing, photo }, index) => <section class="review-apartment" id={listing.propertyId} aria-labelledby={`${listing.propertyId}-heading`}>
      <div class="apartment-summary">
        <h2 id={`${listing.propertyId}-heading`}>{listing.shortName}<em>.</em></h2>
        <a class="apartment-photo" href={`/stays/${listing.propertyId}/`} aria-label={`Explore the ${listing.shortName} apartment`}>
          <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'}/>
        </a>
        <div class="listing-rating">
          <p><span class="rating-star" aria-hidden="true">★</span> <strong>{listing.rating.toFixed(2)}</strong><span class="rating-scale"> / 5</span></p>
          <span>Overall on Airbnb<br />{listing.reviewCount} reviews</span>
        </div>
        <p class="checked-date">Checked <time datetime={REVIEWS_CHECKED_AT}>{checkedDate}</time></p>
        <a class="text-link apartment-link" href={`/stays/${listing.propertyId}/`}>Explore {listing.shortName} <Icon name="arrow" size={15}/></a>
      </div>

      <div class="guest-highlights">
        {listing.excerpts.map(excerpt => <figure class="guest-excerpt">
          <div class="excerpt-rating" aria-label={`${excerpt.rating} out of 5 stars`}><span aria-hidden="true">★★★★★</span><span>{excerpt.rating} / 5</span></div>
          <blockquote cite={listing.sourceUrl}><p>“{excerpt.quote}”</p></blockquote>
          <figcaption><span>{excerpt.guestInitials} <span aria-hidden="true">·</span> <time datetime={excerpt.publishedMonth}>{reviewMonth(excerpt.publishedMonth)}</time></span><span class="excerpt-note">Excerpt{excerpt.translatedByAirbnb && ' · Translated by Airbnb'}</span></figcaption>
        </figure>)}
        <a class="text-link all-reviews" href={listing.sourceUrl} target="_blank" rel="noopener noreferrer">Read all {listing.reviewCount} reviews on Airbnb <Icon name="arrow" size={15}/></a>
      </div>
    </section>)}
  </div>
</Layout>

<style>
  .review-intro { padding-bottom: 58px; }
  .review-intro h1 { margin-bottom: 23px; animation: content-arrive .8s ease-out both; }
  .review-intro .lede { margin-bottom: 7px; }
  .selection-note { color: var(--muted); font-size: 11px; margin: 0; }
  .review-apartments { padding-bottom: 90px; }
  .review-apartment { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: clamp(45px, 7vw, 100px); border-top: 1px solid var(--line); padding-block: 56px 70px; scroll-margin-top: 125px; }
  .review-apartment:last-child { padding-bottom: 0; }
  .apartment-summary h2 { font-size: 54px; margin-bottom: 25px; }
  .apartment-summary h2 em { color: #7c8d67; }
  .apartment-photo { display: block; overflow: hidden; }
  .apartment-photo img { aspect-ratio: 4 / 3; object-fit: cover; transition: transform .6s ease; }
  .apartment-photo:hover img { transform: scale(1.025); }
  .listing-rating { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 23px; }
  .listing-rating p { margin: 0; line-height: 1; }
  .listing-rating strong { font-family: var(--serif); font-size: 46px; font-weight: 500; letter-spacing: -.025em; }
  .rating-star { font-size: 20px; vertical-align: 5px; margin-right: 5px; }
  .rating-scale { color: var(--muted); font-size: 13px; }
  .listing-rating > span { color: var(--muted); text-align: right; font-size: 11px; line-height: 1.7; }
  .checked-date { font-size: 10px; color: var(--muted); margin: 12px 0 15px; }
  .apartment-link { font-size: 11px; }
  .guest-highlights { padding-top: 5px; }
  .guest-excerpt { margin: 0; padding: 22px 0 26px; border-bottom: 1px solid var(--line); }
  .guest-excerpt:first-child { padding-top: 0; }
  .excerpt-rating { display: flex; align-items: center; gap: 13px; font-size: 10px; margin-bottom: 12px; }
  .excerpt-rating > span:first-child { letter-spacing: .18em; font-size: 12px; }
  .excerpt-rating > span:last-child { color: var(--muted); }
  .guest-excerpt blockquote { margin: 0 0 16px; }
  .guest-excerpt blockquote p { font-family: var(--serif); font-size: clamp(28px, 2.7vw, 37px); line-height: 1.18; letter-spacing: -.02em; margin: 0; }
  .guest-excerpt figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5px 20px; font-size: 11px; line-height: 1.8; }
  .guest-excerpt figcaption time, .excerpt-note { color: var(--muted); }
  .guest-excerpt figcaption > span:first-child > span { margin-inline: 6px; }
  .excerpt-note { font-size: 10px; }
  .all-reviews { margin-top: 25px; }
  @media (min-width: 901px) { .review-apartment:nth-child(2) .apartment-summary { order: 2; } }
  @media (max-width: 900px) {
    .review-apartment { grid-template-columns: 1fr; gap: 38px; padding-block: 40px 55px; }
    .apartment-summary h2 { font-size: 45px; margin-bottom: 21px; }
    .guest-excerpt blockquote p { max-width: 650px; font-size: 34px; }
  }
  @media (max-width: 560px) {
    .review-intro { padding-bottom: 35px; }
    .selection-note { font-size: 10px; max-width: 290px; }
    .review-apartments { padding-bottom: 55px; }
    .review-apartment { scroll-margin-top: 100px; }
    .guest-excerpt blockquote p { font-size: 31px; }
    .guest-excerpt figcaption { display: grid; gap: 3px; }
  }
</style>
