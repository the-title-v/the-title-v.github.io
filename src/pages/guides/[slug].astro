---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import InternetSpeed from '../../components/InternetSpeed.astro';
import { guides } from '../../data/guides';
import { images, properties } from '../../data/properties';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const isComparison = guide.category === 'comparison';
const related = guides.filter(item => guide.relatedGuides.includes(item.slug));
const heading = guide.heading || guide.title;
const description = guide.metaDescription || guide.summary;
const apartmentChoices = [
  { property: properties[0], label: 'Bright', photo: guide.hero.src === images.brightLiving.src ? images.brightBedroom : images.brightLiving, detail: 'Light-filled living space. A balcony overlooking greenery.' },
  { property: properties[1], label: 'Cozy', photo: guide.hero.src === images.cozyLiving.src ? images.cozyBedroom : images.cozyLiving, detail: 'Warm interiors. A garden-facing balcony for your morning coffee.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: heading, description, image: new URL(guide.hero.src, Astro.site).href, author: { '@type': 'Organization', name: 'The Title V', url: Astro.site?.href }, publisher: { '@type': 'Organization', name: 'The Title V' }, mainEntityOfPage: new URL(`/guides/${guide.slug}/`, Astro.site).href, inLanguage: 'en', ...(guide.updatedAt ? { dateModified: guide.updatedAt } : {}) };
---
<Layout title={guide.title} seoTitle={guide.seoTitle} description={description} image={guide.hero.src} schema={schema}>
  {isComparison ? <>
    <section class="comparison-hero" aria-labelledby="comparison-title">
      <img class="comparison-hero-image" src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} fetchpriority="high"/>
      <div class="comparison-hero-shade" aria-hidden="true"></div>
      <div class="comparison-hero-content container">
        <p class="comparison-brand">The Title V <span>Rawai · Phuket</span></p>
        <h1 id="comparison-title">{heading}</h1>
        <p class="comparison-lede">{guide.intro || guide.summary}</p>
        <div class="comparison-actions">
          <a class="button button-light" href="/book/">Check dates <Icon name="arrow" size={17}/></a>
          <a class="comparison-apartments-link" href="#choose-your-apartment">See apartments</a>
        </div>
      </div>
    </section>
    <article class="comparison-story container" aria-label={guide.title}>
      {guide.sections.map((section, index) => <section class="comparison-benefit" id={`part-${index}`}>
        <h2>{section.heading}</h2>
        <div class="comparison-benefit-copy">
          {section.paragraphs.map(text => <p>{text}</p>)}
          {section.bullets && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}
          {section.links && <ul class="comparison-links">{section.links.map(link => <li><a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.title} <Icon name="arrow" size={14}/></a></li>)}</ul>}
        </div>
      </section>)}
      {related.length > 0 && <nav class="comparison-more" aria-label="More ways to plan your stay"><p class="eyebrow">A LITTLE MORE RAWAI</p>{related.slice(0, 3).map(item => <a href={`/guides/${item.slug}/`}>{item.title} <Icon name="arrow" size={14}/></a>)}</nav>}
    </article>
    <section class="comparison-apartments" id="choose-your-apartment" aria-labelledby="apartment-heading">
      <div class="container">
        <div class="comparison-apartments-heading"><p class="eyebrow">YOUR HOME AT THE TITLE V</p><h2 id="apartment-heading">Make yourself <em>at home.</em></h2><p>Two one-bedroom apartments. Your own kitchen, washer and balcony. Choose the one that feels like you.</p></div>
        <div class="comparison-apartment-grid">
          {apartmentChoices.map(({ property, label, photo, detail }) => <article class="comparison-apartment">
            <a class="comparison-apartment-photo" href={`/stays/${property.slug}/`} aria-label={`See ${property.name}`}><img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy"/></a>
            <h3><a href={`/stays/${property.slug}/`}>{label} <Icon name="arrow" size={22}/></a></h3>
            <p>{detail}</p>
          </article>)}
        </div>
        <div class="comparison-pair"><div><h3>Coming with family or friends?</h3><p>Book Bright and Cozy together: adjacent homes with separate entrances and your own space.</p></div><a class="text-link" href="/stays/two-adjacent-apartments-title-v-rawai/">See both apartments <Icon name="arrow" size={16}/></a></div>
        <p class="comparison-stay-note">Stays from seven nights. <a href="/booking-terms/">See booking details</a>.</p>
      </div>
    </section>
  </> : <>
  <section class="page-intro container">
    <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/guides/">The Rawai journal</a></div>
    <p class="eyebrow">{guide.eyebrow} · {guide.readTime}</p>
    <h1 class="simple-title">{heading}</h1>
    <p class="lede">{guide.intro || guide.summary}</p>
    {guide.updatedAt && <p class="guide-updated">Updated <time datetime={guide.updatedAt}>{new Date(`${guide.updatedAt}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>}
  </section>
  <div class="container">
    <figure class="article-figure">
      <img class="article-hero" src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} fetchpriority="high"/>
      {(guide.hero.caption || guide.heroCredit) && <figcaption>
        {guide.hero.caption}
        {guide.heroCredit && <span class="photo-credit"> Photo: <a href={guide.heroCredit.url} target="_blank" rel="noopener noreferrer">{guide.heroCredit.author}</a>{guide.heroCredit.license && guide.heroCredit.licenseUrl && <> · <a href={guide.heroCredit.licenseUrl} target="_blank" rel="noopener noreferrer">{guide.heroCredit.license}</a></>}</span>}
      </figcaption>}
    </figure>
  </div>
  <section class="container content-section article-layout">
    <article class="rich-copy">{guide.slug === 'work-from-phuket' && <InternetSpeed/>}
      {guide.sections.map((section, index) => <section id={`part-${index}`}>
        <h2>{section.heading}</h2>
        {section.paragraphs.map(text => <p>{text}</p>)}
        {section.bullets && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}
        {section.table && <div class="guide-table-wrap"><table class="guide-table"><thead><tr>{section.table.headings.map(heading => <th scope="col">{heading}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}
        {section.links && <ul class="guide-links">{section.links.map(link => <li><a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.title} <Icon name="arrow" size={13}/></a></li>)}</ul>}
      </section>)}
      {guide.sources.length > 0 && <div class="sources"><p class="eyebrow">USEFUL LINKS</p><ul>{guide.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <Icon name="arrow" size={13}/></a></li>)}</ul></div>}
    </article>
    <aside>
      <p class="eyebrow">IN THIS GUIDE</p>
      {guide.sections.map((section, index) => <a href={`#part-${index}`}>{section.heading}</a>)}
      <div style="margin-top:35px"><p class="eyebrow">STAY IN RAWAI</p><p style="font-size:1rem;color:var(--muted)">Your own apartment at The Title V.</p><a href="/stays/" class="text-link">Explore the apartments <Icon name="arrow" size={15}/></a></div>
    </aside>
  </section>
  {related.length > 0 && <section class="journal-section section"><div class="container"><p class="eyebrow">KEEP EXPLORING</p><h2>A little more <em>inspiration.</em></h2><div class="guide-grid">{related.slice(0, 3).map(item => <article class="guide-card"><a class="guide-image" href={`/guides/${item.slug}/`}><img src={item.hero.src} width={item.hero.width} height={item.hero.height} alt={item.hero.alt} loading="lazy"/></a><h3><a href={`/guides/${item.slug}/`}>{item.title}</a></h3></article>)}</div></div></section>}
  </>}
</Layout>
<style>
  .comparison-hero { position: relative; isolation: isolate; display: grid; align-items: center; min-height: min(680px, calc(100svh - 98px)); overflow: hidden; background: var(--forest-dark); color: var(--paper); }
  .comparison-hero-image, .comparison-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .comparison-hero-image { object-fit: cover; object-position: center 55%; animation: comparison-image-arrive 1.2s ease-out both; }
  .comparison-hero-shade { background: linear-gradient(90deg, rgba(10,29,22,.82) 0%, rgba(10,29,22,.72) 45%, rgba(10,29,22,.18) 100%); }
  .comparison-hero-content { padding-block: 55px; animation: comparison-copy-arrive .8s ease-out both; }
  .comparison-brand { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 18px; font-family: var(--serif); font-size: 29px; line-height: 1.1; margin-bottom: 23px; }
  .comparison-brand span { font-family: var(--sans); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; }
  .comparison-hero h1 { max-width: 700px; margin-bottom: 22px; font-size: clamp(48px, 5.5vw, 78px); line-height: .99; letter-spacing: -.025em; text-wrap: balance; }
  .comparison-lede { max-width: 540px; margin-bottom: 27px; color: #f5f6ef; font-size: 1rem; line-height: 1.75; text-wrap: pretty; }
  .comparison-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 26px; }
  .comparison-actions .button { gap: 24px; }
  .comparison-apartments-link { display: inline-flex; align-items: center; min-height: 48px; font-size: 1rem; text-decoration: underline; text-underline-offset: 6px; text-decoration-color: #ffffff80; transition: text-decoration-color .2s; }
  .comparison-apartments-link:hover { text-decoration-color: currentColor; }
  .comparison-hero a:focus-visible { outline-color: white; }
  .comparison-story { padding-block: 48px 65px; }
  .comparison-benefit { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 34px 90px; padding-block: 42px; border-bottom: 1px solid var(--line); scroll-margin-top: 120px; }
  .comparison-benefit h2 { max-width: 420px; font-size: clamp(35px, 3.3vw, 48px); line-height: 1.07; margin: 0; text-wrap: balance; }
  .comparison-benefit-copy { max-width: 600px; }
  .comparison-benefit-copy p, .comparison-benefit-copy li { color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .comparison-benefit-copy p { margin-bottom: 18px; }
  .comparison-benefit-copy p:last-child { margin-bottom: 0; }
  .comparison-benefit-copy ul { padding-left: 19px; }
  .comparison-benefit-copy .comparison-links { display: flex; flex-wrap: wrap; gap: 2px 25px; list-style: none; padding: 0; margin: 7px 0 0; }
  .comparison-links a, .comparison-more a { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; line-height: 1.5; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: #9cad98; }
  .comparison-links a { color: var(--forest); }
  .comparison-links svg, .comparison-more svg, .comparison-pair svg { flex-shrink: 0; }
  .comparison-more { display: flex; flex-wrap: wrap; gap: 4px 32px; padding-top: 31px; }
  .comparison-more .eyebrow { flex-basis: 100%; font-size: .7rem; margin-bottom: 4px; }
  .comparison-more a { font-size: .875rem; color: var(--muted); }
  .comparison-apartments { padding-block: 68px 48px; background: var(--sage); scroll-margin-top: 98px; }
  .comparison-apartments-heading { max-width: 610px; margin-bottom: 36px; }
  .comparison-apartments-heading h2 { margin-bottom: 18px; }
  .comparison-apartments-heading > p:last-child { max-width: 520px; margin: 0; color: var(--muted); }
  .comparison-apartment-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 38px; }
  .comparison-apartment-photo { display: block; aspect-ratio: 1.5; overflow: hidden; }
  .comparison-apartment-photo img { height: 100%; object-fit: cover; transition: transform .6s ease; }
  .comparison-apartment-photo:hover img { transform: scale(1.035); }
  .comparison-apartment h3 { font-size: 40px; margin: 16px 0 6px; }
  .comparison-apartment h3 a { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .comparison-apartment h3 svg { transition: transform .2s ease; }
  .comparison-apartment h3 a:hover svg { transform: translateX(5px); }
  .comparison-apartment p { color: var(--muted); margin: 0; }
  .comparison-pair { display: flex; justify-content: space-between; align-items: center; gap: 28px; margin-top: 36px; padding-top: 28px; border-top: 1px solid #cbd5c6; }
  .comparison-pair h3 { font-size: 29px; margin-bottom: 8px; }
  .comparison-pair p { color: var(--muted); max-width: 600px; margin: 0; }
  .comparison-pair .text-link { flex-shrink: 0; }
  .comparison-stay-note { font-size: .875rem; color: var(--muted); margin: 30px 0 0; }
  .comparison-stay-note a { text-decoration: underline; text-underline-offset: 4px; }
  @keyframes comparison-image-arrive { from { transform: scale(1.025); } to { transform: scale(1); } }
  @keyframes comparison-copy-arrive { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (max-width: 800px) {
    .comparison-hero { min-height: min(670px, calc(100svh - 82px)); }
    .comparison-hero-shade { background: linear-gradient(90deg, rgba(10,29,22,.78), rgba(10,29,22,.55)); }
    .comparison-hero-content { padding-block: 44px; }
    .comparison-hero h1 { max-width: 600px; font-size: clamp(44px, 7.5vw, 62px); }
    .comparison-benefit { gap: 28px 42px; }
    .comparison-apartment-grid { gap: 26px; }
    .comparison-pair { flex-direction: column; align-items: flex-start; gap: 15px; }
  }
  @media (max-width: 560px) {
    .comparison-hero { min-height: min(650px, calc(100svh - 78px)); }
    .comparison-hero-content { padding-block: 28px; }
    .comparison-brand { font-size: 25px; gap: 8px 14px; margin-bottom: 20px; }
    .comparison-brand span { font-size: .625rem; letter-spacing: .11em; }
    .comparison-hero h1 { font-size: clamp(35px, 10vw, 50px); line-height: 1.02; margin-bottom: 18px; }
    .comparison-lede { font-size: .9375rem; line-height: 1.65; margin-bottom: 22px; }
    .comparison-actions { gap: 10px 18px; }
    .comparison-actions .button { padding: 12px 17px; gap: 17px; font-size: .875rem; }
    .comparison-apartments-link { font-size: .875rem; }
    .comparison-story { padding-block: 10px 38px; }
    .comparison-benefit { grid-template-columns: minmax(0, 1fr); gap: 18px; padding-block: 32px; scroll-margin-top: 95px; }
    .comparison-benefit h2 { max-width: 360px; font-size: 36px; text-wrap: pretty; }
    .comparison-benefit-copy p, .comparison-benefit-copy li { line-height: 1.75; }
    .comparison-more { padding-top: 24px; gap: 2px; }
    .comparison-more a { width: 100%; }
    .comparison-apartments { padding-block: 42px 34px; scroll-margin-top: 78px; }
    .comparison-apartments-heading { margin-bottom: 27px; }
    .comparison-apartments-heading h2 { font-size: 43px; }
    .comparison-apartment-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .comparison-apartment h3 { font-size: 35px; margin-top: 13px; }
    .comparison-pair { margin-top: 28px; padding-top: 23px; }
    .comparison-pair h3 { font-size: 28px; }
  }
  @media (max-width: 360px) {
    .comparison-brand { font-size: 23px; gap: 10px; margin-bottom: 17px; }
    .comparison-brand span { font-size: .6rem; letter-spacing: .07em; }
    .comparison-hero h1 { font-size: 34px; margin-bottom: 15px; }
    .comparison-lede { font-size: .875rem; line-height: 1.65; margin-bottom: 18px; }
    .comparison-actions { gap: 12px; }
    .comparison-actions .button { padding-inline: 15px; gap: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .comparison-hero-image, .comparison-hero-content { animation: none; }
    .comparison-apartment-photo img, .comparison-apartment h3 svg, .comparison-apartments-link { transition: none; }
  }
  .guide-updated { color: var(--muted); font-size: .875rem; margin-bottom: 0; }
  .simple-title { max-width: 1050px; text-wrap: balance; font-size: clamp(40px, 5.3vw, 76px); }
  .photo-credit { font-size: .9em; }
  .photo-credit a { text-decoration: underline; text-underline-offset: 3px; }
  .guide-links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 18px 0 30px; }
  .guide-links li { padding: 0; margin: 0; font-size:1rem; }
  .guide-links a { display: inline-flex; align-items: center; gap: 7px; text-decoration: underline; text-underline-offset: 4px; }
  .guide-table-wrap { margin: 24px 0; overflow-x: auto; }
  .guide-table { width: 100%; border-collapse: collapse; font-size:1rem; line-height: 1.6; }
  .guide-table th, .guide-table td { padding: 16px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
  .guide-table thead th { font-weight: 600; color: var(--forest); }
  .guide-table tbody th { width: 30%; font-weight: 500; }
  @media (max-width: 500px) {
    .guide-table th, .guide-table td { padding: 12px 8px; }
    .guide-table tbody th { width: 32%; }
    .guide-links { display: block; }
    .guide-links li { margin-bottom: 10px; }
  }
</style>
