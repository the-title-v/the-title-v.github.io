---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
const comparisons = guides.filter(guide => guide.category === 'comparison');
const localGuides = guides.filter(guide => guide.category !== 'comparison');
---
<Layout title="The Rawai journal · Local guides" seoTitle="Rawai Rental Comparisons & Local Guides | The Title V" description="Compare The Title residences and plan a stay in Rawai, Phuket: apartment choices, monthly rentals, beaches, food and practical transport guides.">
  <section class="page-intro container"><p class="eyebrow">NOTES FROM OUR CORNER OF PHUKET</p><h1>The Rawai <em>journal.</em></h1><p class="lede">Good places. Easy outings. The useful details for a week — or a little longer.</p></section>
  <nav class="container guide-shortcuts" aria-label="Plan your stay"><a href="/explore-phuket/">Island map <Icon name="pin" size={16}/></a><a href="/guides/phuket-airport-to-rawai/">Getting here <Icon name="arrow" size={16}/></a><a href="/visas/">Visas & entry <Icon name="arrow" size={16}/></a><a href="/guides/rawai-park-with-children/">Rawai Park <Icon name="arrow" size={16}/></a><a href="/guides/rawai-schools-and-kindergartens/">Schools <Icon name="arrow" size={16}/></a><a href="/guides/rawai-banks-and-atms/">Banks & ATMs <Icon name="arrow" size={16}/></a></nav>
  {comparisons.length > 0 && <section id="compare-residences" class="container content-section"><div class="section-heading"><div><p class="eyebrow">FIND YOUR PLACE</p><h2>Compare The Title residences</h2></div></div><p class="comparison-intro">Considering another Title property? Compare the residences, areas and apartment details before choosing your stay.</p><div class="comparison-grid">{comparisons.map(guide => <article class="comparison-card"><p class="eyebrow">{guide.eyebrow}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><a class="text-link" href={`/guides/${guide.slug}/`}>Read the comparison <Icon name="arrow" size={16}/></a></article>)}</div></section>}
  <section class="container content-section"><p class="eyebrow">EVERYDAY RAWAI</p><h2>Plan your stay</h2><div class="guide-grid wide-guide-grid">{localGuides.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><p class="eyebrow">{guide.eyebrow} · {guide.readTime}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><a class="text-link" href={`/guides/${guide.slug}/`}>Read the guide <Icon name="arrow" size={16}/></a></article>)}</div></section>
</Layout>

<style>.guide-shortcuts{display:flex;gap:15px 26px;flex-wrap:wrap;border-block:1px solid var(--line);padding-block:15px}.guide-shortcuts a{display:flex;align-items:center;gap:12px;font-size:1rem;min-height:40px}.guide-shortcuts a:hover{color:#8a6b3a}</style>
<style>.comparison-intro{max-width:730px;color:var(--muted);margin-bottom:32px}.comparison-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 44px}.comparison-card{border-top:1px solid var(--line);padding-top:26px}.comparison-card p:not(.eyebrow){color:var(--muted)}.comparison-card h3{font-size:clamp(28px,3vw,36px);max-width:520px}@media(max-width:700px){.comparison-grid{grid-template-columns:1fr}}</style>
