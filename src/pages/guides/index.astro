---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
---
<Layout title="The Rawai journal · Local guides" description="Practical, thoughtful guides to a stay in Rawai, Phuket: beaches, food, transport, longer stays, remote work and days at your own pace.">
  <section class="page-intro container"><p class="eyebrow">NOTES FROM OUR CORNER OF PHUKET</p><h1>The Rawai <em>journal.</em></h1><p class="lede">A few things worth knowing before you arrive. A little inspiration for when you get here. Find your own way to enjoy the south of Phuket.</p></section>
  <section class="container content-section"><div class="guide-grid wide-guide-grid">{guides.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><p class="eyebrow">{guide.eyebrow} · {guide.readTime}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><a class="text-link" href={`/guides/${guide.slug}/`}>Read the guide <Icon name="arrow" size={16}/></a></article>)}</div></section>
</Layout>
