---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
---
<Layout title="The Rawai journal · Local guides" description="Practical, thoughtful guides to a stay in Rawai, Phuket: beaches, food, transport, longer stays, remote work and days at your own pace.">
  <section class="page-intro container"><p class="eyebrow">NOTES FROM OUR CORNER OF PHUKET</p><h1>The Rawai <em>journal.</em></h1><p class="lede">Good places. Easy outings. The useful details for a week — or a little longer.</p></section>
  <nav class="container guide-shortcuts" aria-label="Plan your stay"><a href="/explore-phuket/">Island map <Icon name="pin" size={16}/></a><a href="/guides/phuket-airport-to-rawai/">Getting here <Icon name="arrow" size={16}/></a><a href="/visas/">Visas & entry <Icon name="arrow" size={16}/></a><a href="/guides/rawai-park-with-children/">Rawai Park <Icon name="arrow" size={16}/></a><a href="/guides/rawai-schools-and-kindergartens/">Schools <Icon name="arrow" size={16}/></a><a href="/guides/rawai-banks-and-atms/">Banks & ATMs <Icon name="arrow" size={16}/></a></nav>
  <section class="container content-section"><div class="guide-grid wide-guide-grid">{guides.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><p class="eyebrow">{guide.eyebrow} · {guide.readTime}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><a class="text-link" href={`/guides/${guide.slug}/`}>Read the guide <Icon name="arrow" size={16}/></a></article>)}</div></section>
</Layout>

<style>.guide-shortcuts{display:flex;gap:15px 26px;flex-wrap:wrap;border-block:1px solid var(--line);padding-block:15px}.guide-shortcuts a{display:flex;align-items:center;gap:12px;font-size:12px;min-height:40px}.guide-shortcuts a:hover{color:#8a6b3a}</style>
