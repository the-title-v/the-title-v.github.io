---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
import { images } from '../../data/properties';
const comparisons = guides.filter(guide => guide.category === 'comparison');
const listicles = guides.filter(guide => guide.category === 'listicle');
const localGuides = guides.filter(guide => !guide.category);
---
<Layout title="The Rawai journal · Local guides" seoTitle="Rawai Rental Comparisons & Local Guides | The Title V" description="Compare The Title residences and plan a stay in Rawai, Phuket: apartment choices, monthly rentals, beaches, food and practical transport guides.">
  <section class="page-intro container"><p class="eyebrow">NOTES FROM OUR CORNER OF PHUKET</p><h1>The Rawai <em>journal.</em></h1><p class="lede">Good places. Easy outings. The useful details for a week — or a little longer.</p></section>
  <nav class="container guide-shortcuts" aria-label="Plan your stay"><a href="/explore-phuket/">Island map <Icon name="pin" size={16}/></a><a href="/guides/phuket-airport-to-rawai/">Getting here <Icon name="arrow" size={16}/></a><a href="/visas/">Visas & entry <Icon name="arrow" size={16}/></a><a href="/guides/rawai-park-with-children/">Rawai Park <Icon name="arrow" size={16}/></a><a href="/guides/rawai-schools-and-kindergartens/">Schools <Icon name="arrow" size={16}/></a><a href="/guides/rawai-banks-and-atms/">Banks & ATMs <Icon name="arrow" size={16}/></a></nav>
  <section id="stay-ideas" class="container content-section" aria-labelledby="stay-ideas-heading">
    <p class="eyebrow">MAKE YOURSELF AT HOME</p><h2 id="stay-ideas-heading">Ideas for an easier stay</h2>
    <div class="guide-grid wide-guide-grid">{listicles.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><p class="eyebrow">{guide.eyebrow} · {guide.readTime}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><a class="text-link" href={`/guides/${guide.slug}/`}>Read the guide <Icon name="arrow" size={16}/></a></article>)}</div>
  </section>
  {comparisons.length > 0 && <section id="compare-residences" class="container content-section comparison-section" aria-labelledby="comparison-heading">
    <div class="comparison-intro">
      <img src={images.poolSide.src} width={images.poolSide.width} height={images.poolSide.height} alt={images.poolSide.alt} loading="lazy"/>
      <div><p class="eyebrow">YOUR PLACE IN RAWAI</p><h2 id="comparison-heading">Why choose<br/>The Title V?</h2><p>Modern apartments, pool mornings and a quieter setting away from the main road. Enjoy the shared gym and sauna, then come home to your own kitchen and balcony.</p><a class="button" href="/book/">Check dates <Icon name="arrow" size={17}/></a></div>
    </div>
    <nav class="comparison-list" aria-label="Choose The Title V for your Phuket stay">
      {comparisons.map(guide => <a class="comparison-choice" href={`/guides/${guide.slug}/`}><h3>{guide.title}</h3><p>{guide.summary}</p><Icon name="arrow" size={20}/></a>)}
    </nav>
  </section>}
  <section class="container content-section"><p class="eyebrow">EVERYDAY RAWAI</p><h2>Plan your stay</h2><div class="guide-grid wide-guide-grid">{localGuides.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><p class="eyebrow">{guide.eyebrow} · {guide.readTime}</p><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3><p>{guide.summary}</p><a class="text-link" href={`/guides/${guide.slug}/`}>Read the guide <Icon name="arrow" size={16}/></a></article>)}</div></section>
</Layout>

<style>.guide-shortcuts{display:flex;gap:15px 26px;flex-wrap:wrap;border-block:1px solid var(--line);padding-block:15px}.guide-shortcuts a{display:flex;align-items:center;gap:12px;font-size:1rem;min-height:40px}.guide-shortcuts a:hover{color:#8a6b3a}</style>
<style>
  .comparison-section { scroll-margin-top: 98px; }
  .comparison-intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 60px; align-items: center; margin-bottom: 42px; }
  .comparison-intro > img { aspect-ratio: 1.12; height: 100%; object-fit: cover; }
  .comparison-intro h2 { line-height: 1.02; margin-bottom: 22px; }
  .comparison-intro > div > p:not(.eyebrow) { max-width: 460px; color: var(--muted); margin-bottom: 24px; }
  .comparison-list { border-top: 1px solid var(--line); }
  .comparison-choice { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) 20px; align-items: center; gap: 36px; padding-block: 26px; border-bottom: 1px solid var(--line); }
  .comparison-choice h3 { font-size: clamp(27px, 2.5vw, 35px); line-height: 1.13; margin: 0; }
  .comparison-choice p { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0; }
  .comparison-choice svg { transition: transform .2s ease; }
  .comparison-choice:hover h3 { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .comparison-choice:hover svg { transform: translateX(4px); }
  @media (max-width: 800px) {
    .comparison-intro { gap: 32px; }
    .comparison-intro h2 { font-size: 45px; }
    .comparison-choice { gap: 24px; }
  }
  @media (max-width: 600px) {
    .comparison-section { scroll-margin-top: 78px; }
    .comparison-intro { grid-template-columns: minmax(0, 1fr); gap: 27px; margin-bottom: 32px; }
    .comparison-intro > img { aspect-ratio: 1.5; }
    .comparison-intro h2 { font-size: 44px; }
    .comparison-intro .eyebrow { margin-bottom: 14px; }
    .comparison-choice { grid-template-columns: minmax(0, 1fr) 20px; gap: 12px 18px; padding-block: 23px; }
    .comparison-choice h3 { font-size: 31px; }
    .comparison-choice p { grid-column: 1; }
    .comparison-choice svg { grid-column: 2; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .comparison-choice svg { transition: none; } }
</style>
