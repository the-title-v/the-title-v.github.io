---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { informationPages } from '../data/pages';
export function getStaticPaths() { return informationPages.map(page => ({ params: { page: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<Layout title={page.title} seoTitle={page.seoTitle} description={page.description} image={'image' in page ? page.image : undefined}>
  <section class="page-intro container"><p class="eyebrow">{page.eyebrow}</p><h1 class="simple-title">{page.heading}</h1><p class="lede">{page.intro}</p>{page.slug === 'contact' && <a class="button" href={page.ctaUrl} target="_blank" rel="noopener noreferrer">{page.cta} <Icon name="arrow" size={16}/></a>}</section>
  {'image' in page && <div class="container"><img class="page-wide-image" src={page.image} alt={page.alt} width="1920" height="1440" fetchpriority="high"/></div>}
  <section class="container content-section two-columns"><div class="rich-copy">{page.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(text => <p>{text}</p>)}</section>)}<nav class="information-links" aria-label="Related information">{page.relatedLinks.map(link => <a class="text-link" href={link.href}>{link.label} <Icon name="arrow" size={14}/></a>)}</nav></div><aside class="aside-note"><p class="eyebrow">A PERSONAL CONNECTION</p><h3>Your questions.<br /><em>A real conversation.</em></h3><p>Speak directly with our booking team about your stay.</p><a class="button" href={page.ctaUrl} target="_blank" rel="noopener noreferrer">{page.cta} <Icon name="arrow" size={16}/></a><a class="text-link" href="/book/" style="margin-top:22px">Check dates & prices <Icon name="arrow" size={14}/></a></aside></section>
</Layout>

<style>.information-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:30px}.information-links .text-link{width:fit-content}</style>
