---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { informationPages } from '../data/pages';
export function getStaticPaths() { return informationPages.map(page => ({ params: { page: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<Layout title={page.title} description={page.description} image={'image' in page ? page.image : undefined}>
  <section class="page-intro container"><p class="eyebrow">{page.eyebrow}</p><h1 class="simple-title">{page.title}</h1><p class="lede">{page.intro}</p></section>
  {'image' in page && <div class="container"><img class="page-wide-image" src={page.image} alt={page.alt} width="1920" height="1440" fetchpriority="high"/></div>}
  <section class="container content-section two-columns"><div class="rich-copy">{page.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(text => <p>{text}</p>)}</section>)}</div><aside class="aside-note"><p class="eyebrow">A PERSONAL CONNECTION</p><h3>Your questions.<br /><em>A real conversation.</em></h3><p>Speak directly with your host to arrange your stay.</p><a class="button" href={page.ctaUrl} target="_blank" rel="noopener noreferrer">{page.cta} <Icon name="arrow" size={16}/></a><a class="text-link" href="/book/" style="margin-top:22px">Check dates & prices <Icon name="arrow" size={14}/></a></aside></section>
</Layout>
