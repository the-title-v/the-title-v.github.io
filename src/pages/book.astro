---
import Layout from '../layouts/Layout.astro';
import BookingWidget from '../components/BookingWidget';
import { properties } from '../data/properties';
const stays = properties.map(property => ({ slug: property.slug, name: property.name, guests: property.guests, image: property.hero.src }));
---
<Layout title="Availability & direct booking" description="Check live Airbnb calendars, calculate a seasonal stay estimate with weekly and monthly discounts, and request your Title V apartment directly with your host.">
  <div class="container"><section class="page-intro"><p class="eyebrow">A FEW DETAILS. A LOVELY STAY.</p><h1 class="simple-title">Find your time in <em>Rawai.</em></h1><p class="lede">Choose your apartment and dates. We’ll take care of the maths.<br />Then say hello to your host to arrange the rest.</p></section><BookingWidget stays={stays} client:only="react"><p slot="fallback" class="notice">Preparing your calendar and stay calculator…</p></BookingWidget><noscript><p class="notice">The live calendar and calculator need JavaScript. You can still <a href="/rates/">read the seasonal rates</a> and <a href="https://wa.me/79139098949">request your dates on WhatsApp</a>.</p></noscript></div>
</Layout>
