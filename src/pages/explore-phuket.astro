---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import IslandMap from '../components/IslandMap.astro';
import { islandPlaces, directionsTo } from '../data/phuket';
---
<Layout title="Explore Phuket · 15 places worth the trip" description="A whole-island map of Phuket’s beaches, viewpoints, temples and shopping: 15 places to explore from your Rawai apartment, with directions.">
  <section class="page-intro container"><p class="eyebrow">YOUR ISLAND, AT A GLANCE</p><h1>Go a little <em>further.</em></h1><p class="lede">Beach mornings, hilltop views and Old Town afternoons.<br />Fifteen places to put on your Phuket map.</p></section>
  <section class="container island-section" aria-label="Map of Phuket"><IslandMap/><p class="island-intro-note">Start in the south for an easy day. Save the northern beaches for a longer outing.</p></section>
  <section class="container island-places"><div class="section-heading"><div><p class="eyebrow">PICK YOUR KIND OF DAY</p><h2>From Rawai,<br /><em>around the island.</em></h2></div><p>Tap a number on the map, or choose a place below. At every beach, follow the flags before swimming.</p></div><div class="island-place-list">{islandPlaces.map((place, i) => <article id={`place-${place.id}`}><div class="island-place-top"><span class="island-number">{String(i + 1).padStart(2, '0')}</span><span class="eyebrow">{place.kind}</span></div><h3>{place.name}</h3><p>{place.note}</p><p class="island-tip">{place.tip}</p><div class="island-links"><button type="button" data-map-place={place.id}>Show on map</button><a href={directionsTo(place.name)} target="_blank" rel="noopener noreferrer" aria-label={`Directions to ${place.name}`}>Directions <Icon name="arrow" size={12}/></a><a href={place.source} target="_blank" rel="noopener noreferrer" aria-label={`Visitor information for ${place.name}`}>More info <Icon name="arrow" size={12}/></a></div></article>)}</div></section>
  <section class="container island-next"><div><p class="eyebrow">KEEP IT CLOSE TO HOME</p><h2>Or stay <em>local.</em></h2><p>Waterfront cafés, seafood, boat trips and everyday essentials around Rawai.</p><a href="/location/" class="text-link">Explore the neighbourhood <Icon name="arrow" size={15}/></a></div><div><a href="/guides/phuket-airport-to-rawai/">Airport to Rawai <Icon name="arrow" size={16}/></a><a href="/guides/rawai-park-with-children/">Rawai Park & family days <Icon name="arrow" size={16}/></a><a href="/visas/">Visas & arrival essentials <Icon name="arrow" size={16}/></a></div></section>
</Layout>
<style>
  .island-section{padding-bottom:35px}.island-intro-note{font-size:1rem;color:var(--muted);margin-top:17px}.island-places{padding:35px 0 75px}.section-heading>p{font-size:1rem;color:var(--muted);max-width:330px}.island-place-list{display:grid;grid-template-columns:repeat(3,1fr);gap:40px 38px}.island-place-list article{border-top:1px solid var(--line);padding:22px 0 0;scroll-margin-top:130px;display:flex;flex-direction:column}.island-place-top{display:flex;gap:17px;align-items:center;margin-bottom:17px}.island-number{font:25px var(--serif);color:#a6632c}.island-place-top .eyebrow{font-size:.75rem;margin:0}.island-place-list h3{font-size:32px;margin-bottom:14px}.island-place-list p{font-size:1rem;line-height:1.8;margin-bottom:13px}.island-place-list .island-tip{color:var(--muted);font-size:.875rem}.island-links{display:flex;gap:15px;flex-wrap:wrap;margin-top:auto;padding-top:8px}.island-links a,.island-links button{font:.875rem var(--sans);background:none;border:0;border-bottom:1px solid var(--line);color:var(--forest);padding:7px 0;cursor:pointer;display:inline-flex;align-items:center;gap:4px}.island-next{display:grid;grid-template-columns:1.4fr 1fr;gap:80px;padding-block:55px 80px;border-top:1px solid var(--line)}.island-next p:not(.eyebrow){font-size:1rem;color:var(--muted);max-width:360px}.island-next>div:last-child{display:flex;flex-direction:column;justify-content:center}.island-next>div:last-child a{padding:20px 0;border-bottom:1px solid var(--line);font-size:1rem;display:flex;justify-content:space-between}@media(max-width:850px){.island-place-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.island-place-list{grid-template-columns:1fr;gap:30px}.section-heading{flex-direction:column}.island-next{grid-template-columns:1fr;gap:20px;padding-block:40px 60px}.island-places{padding-bottom:45px}.island-links a,.island-links button{min-height:44px}}
</style>
