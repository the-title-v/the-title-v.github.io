---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { properties } from '../../data/properties';
import { guides } from '../../data/guides';
export function getStaticPaths() { return properties.map(property => ({ params: { slug: property.slug }, props: { property } })); }
const { property } = Astro.props;
const related = guides.filter(guide => property.relatedGuides.includes(guide.slug)).slice(0, 3);
const base = Astro.site!;
const apartmentSchema = (apartment: typeof property) => ({
  '@type': 'Apartment',
  name: apartment.name,
  url: new URL(`/stays/${apartment.slug}/`, base).href,
  numberOfBedrooms: apartment.bedrooms,
  numberOfBathroomsTotal: apartment.bathrooms,
  floorSize: { '@type': 'QuantitativeValue', value: apartment.areaSqm, unitCode: 'MTK' },
  occupancy: { '@type': 'QuantitativeValue', value: apartment.guests },
  amenityFeature: apartment.amenities.map(name => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
});
const containsPlace = property.slug === 'two-adjacent-apartments-title-v-rawai'
  ? properties.filter(apartment => apartment.bedrooms === 1).map(apartmentSchema)
  : apartmentSchema(property);
const schema = [
  { '@context': 'https://schema.org', '@type': 'VacationRental', name: property.name, description: property.summary, url: new URL(`/stays/${property.slug}/`, base).href, image: property.gallery.map(photo => new URL(photo.src, base).href), sameAs: property.airbnbUrl, containsPlace, address: { '@type': 'PostalAddress', addressLocality: 'Rawai', addressRegion: 'Phuket', addressCountry: 'TH' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: base.href }, { '@type': 'ListItem', position: 2, name: 'Apartments', item: new URL('/stays/', base).href }, { '@type': 'ListItem', position: 3, name: property.name, item: new URL(`/stays/${property.slug}/`, base).href }] },
];
---
<Layout title={property.name} description={property.summary} image={property.hero.src} schema={schema}>
  <section class="page-intro container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/stays/">Our apartments</a><span>/</span><span>{property.eyebrow}</span></div><p class="eyebrow">{property.eyebrow}</p><h1 class="simple-title">{property.name}</h1><div class="fact-row"><span>{property.guests} guests</span><span>{property.bedrooms} bedroom{property.bedrooms > 1 ? 's' : ''}</span><span>{property.bathrooms} bathroom{property.bathrooms > 1 ? 's' : ''}</span><span>{property.areaSqm} m²</span><span>Rawai, Phuket</span></div></section>
  <div class="container"><div class="photo-grid">{property.gallery.slice(0, 3).map((photo, index) => <a href="#photos" aria-label="Explore apartment photos"><img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'}/></a>)}</div><a href="#photos" class="text-link">Take a look around <Icon name="arrow" size={16}/></a></div>
  <section class="container content-section two-columns"><div class="rich-copy"><h2>A place to <em>settle in.</em></h2>{property.description.map(text => <p>{text}</p>)}<h2>The little comforts</h2><div class="amenity-list">{property.amenities.map(amenity => <span><Icon name="check" size={16}/>{amenity}</span>)}</div>{property.highlights.map(item => <><h3>{item.title}</h3><p>{item.description}</p></>)}<h2>Good to know</h2>{property.practical.map(item => <><h3>{item.title}</h3><p>{item.description}</p></>)}<p><a href={property.airbnbUrl} target="_blank" rel="noopener noreferrer">View this exact apartment listing on Airbnb <Icon name="arrow" size={14}/></a></p></div><aside class="aside-note"><p class="eyebrow">YOUR NEXT CHAPTER IN RAWAI</p><h3>A few nights.<br /><em>Or a little longer.</em></h3><p>Check the calendar and see your seasonal estimate. Weekly and monthly discounts are calculated automatically.</p><a class="button" href={`/book/?property=${property.slug}`}>Find your dates <Icon name="arrow" size={17}/></a><p style="margin-top:18px;font-size:11px">Speak directly with your host to confirm your stay. No payment is taken on this website.</p><a class="text-link" href="/rates/">How our estimates work <Icon name="arrow" size={15}/></a></aside></section>
  <section id="photos" class="container content-section"><div class="section-heading"><div><p class="eyebrow">THE APARTMENT & THE RESIDENCE</p><h2>Picture yourself <em>here.</em></h2></div></div><div class="apartment-gallery">{property.gallery.map(photo => <figure><a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full photo: ${photo.alt}`}><img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy"/></a><figcaption>{photo.caption || photo.alt}</figcaption></figure>)}</div></section>
  {related.length > 0 && <section class="journal-section section"><div class="container"><p class="eyebrow">MAKE THE MOST OF YOUR STAY</p><h2>A little <em>local knowledge.</em></h2><div class="guide-grid">{related.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3></article>)}</div></div></section>}
</Layout>
