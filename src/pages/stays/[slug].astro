---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import AmenityIcon from '../../components/AmenityIcon.astro';
import InternetSpeed from '../../components/InternetSpeed.astro';
import ListingRating from '../../components/ListingRating.astro';
import { properties } from '../../data/properties';
import { guides } from '../../data/guides';
export function getStaticPaths() { return properties.map(property => ({ params: { slug: property.slug }, props: { property } })); }
const { property } = Astro.props;
const related = guides.filter(guide => property.relatedGuides.includes(guide.slug)).slice(0, 3);
const base = Astro.site!;
const apartmentSchema = (apartment: typeof property) => ({
  '@type': 'Apartment',
  name: apartment.name,
  url: new URL(`/stays/${apartment.slug}/`, base).href,
  numberOfBedrooms: apartment.bedrooms,
  description: `${apartment.capacityLabel}; children aged 14 or under.`,
  petsAllowed: false,
  smokingAllowed: false,
  numberOfBathroomsTotal: apartment.bathrooms,
  floorSize: { '@type': 'QuantitativeValue', value: apartment.areaSqm, unitCode: 'MTK' },
  occupancy: { '@type': 'QuantitativeValue', value: apartment.guests },
  amenityFeature: apartment.amenities.map(name => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
});
const containsPlace = property.slug === 'two-adjacent-apartments-title-v-rawai'
  ? properties.filter(apartment => apartment.bedrooms === 1).map(apartmentSchema)
  : apartmentSchema(property);
const schema = [
  { '@context': 'https://schema.org', '@type': 'VacationRental', name: property.name, description: property.summary, url: new URL(`/stays/${property.slug}/`, base).href, image: property.gallery.map(photo => new URL(photo.src, base).href), sameAs: property.airbnbUrl, checkinTime: '15:00', checkoutTime: '12:00', petsAllowed: false, containsPlace, address: { '@type': 'PostalAddress', addressLocality: 'Rawai', addressRegion: 'Phuket', addressCountry: 'TH' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: base.href }, { '@type': 'ListItem', position: 2, name: 'Apartments', item: new URL('/stays/', base).href }, { '@type': 'ListItem', position: 3, name: property.name, item: new URL(`/stays/${property.slug}/`, base).href }] },
];
---
<Layout title={property.name} description={property.summary} image={property.hero.src} schema={schema}>
  <section class="page-intro container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/stays/">Our apartments</a><span>/</span><span>{property.eyebrow}</span></div><p class="eyebrow">{property.eyebrow}</p><h1 class="simple-title">{property.name}</h1><ListingRating propertyId={property.slug}/>{property.bedrooms > 1 && <a class="text-link" href="/reviews/">Reviews of the individual apartments <Icon name="arrow" size={14}/></a>}<div class="fact-row"><span>{property.capacityLabel}</span><span>{property.bedrooms} bedroom{property.bedrooms > 1 ? 's' : ''}</span><span>{property.bathrooms} bathroom{property.bathrooms > 1 ? 's' : ''}</span><span>{property.areaSqm} m²</span><span>Rawai, Phuket</span></div></section>
  <div class="container">{property.bedrooms > 1 ? <figure class="paired-hero"><img src={property.hero.src} width={property.hero.width} height={property.hero.height} alt={property.hero.alt} fetchpriority="high"/><figcaption>Bright on the left. Cozy on the right. Two independent apartments, side by side.</figcaption></figure> : <div class="photo-grid">{property.gallery.slice(0, 3).map((photo, index) => <a href="#photos" aria-label="Explore apartment photos"><img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'}/></a>)}</div>}<a href="#photos" class="text-link">Take a look around <Icon name="arrow" size={16}/></a></div>
  <section class="container content-section two-columns"><div class="rich-copy"><h2>A place to <em>settle in.</em></h2>{property.description.map(text => <p>{text}</p>)}<p><a href="/residence/">Explore the condominium and shared facilities</a> · <a href="/location/">See the map and what’s nearby</a></p><h2>The little comforts</h2><div class="amenity-list">{property.amenities.map(amenity => <span><AmenityIcon amenity={amenity}/>{amenity}</span>)}</div><InternetSpeed/><h2>Good to know</h2><div class="stay-practical">{property.practical.map(item => <details><summary>{item.title}</summary><p>{item.description}</p></details>)}</div><p><a href={property.airbnbUrl} target="_blank" rel="noopener noreferrer">View on Airbnb <Icon name="arrow" size={14}/></a></p></div><aside class="aside-note"><p class="eyebrow">YOUR NEXT CHAPTER IN RAWAI</p><h3>A week away.<br /><em>Or a little longer.</em></h3><p>Seven nights minimum. Weekly and monthly savings included.</p><a class="button" href={`/book/?property=${property.slug}`}>Find your dates <Icon name="arrow" size={17}/></a><p style="margin-top:18px;font-size:1rem">Our team confirms your booking on WhatsApp.</p><a class="text-link" href="/rates/">Rates & stay details <Icon name="arrow" size={15}/></a></aside></section>
  <section id="photos" class="container content-section"><div class="section-heading"><div><p class="eyebrow">THE APARTMENT & THE RESIDENCE</p><h2>Picture yourself <em>here.</em></h2></div></div><div class="apartment-gallery">{property.gallery.map(photo => <figure><a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full photo: ${photo.alt}`}><img class:list={{ "paired-photo": photo.src.includes("two-apartments-combined") }} src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy"/></a><figcaption>{photo.caption || photo.alt}</figcaption></figure>)}</div></section>
  {related.length > 0 && <section class="journal-section section"><div class="container"><p class="eyebrow">MAKE THE MOST OF YOUR STAY</p><h2>A little <em>local knowledge.</em></h2><div class="guide-grid">{related.map(guide => <article class="guide-card"><a class="guide-image" href={`/guides/${guide.slug}/`}><img src={guide.hero.src} width={guide.hero.width} height={guide.hero.height} alt={guide.hero.alt} loading="lazy"/></a><h3><a href={`/guides/${guide.slug}/`}>{guide.title}</a></h3></article>)}</div></div></section>}
</Layout>

<style>.amenity-list{gap:22px 28px;margin-block:28px 38px}.amenity-list>span{gap:13px;align-items:center;font-size:1rem}.amenity-list svg{flex-shrink:0;color:#6f8060}.stay-practical details{border-bottom:1px solid var(--line);padding-block:14px}.stay-practical summary{cursor:pointer;font-size:1rem;padding-block:6px}.stay-practical p{margin:10px 0 4px;color:var(--muted)}@media(max-width:560px){.amenity-list{gap:20px 14px}.amenity-list>span{font-size:.875rem;gap:9px}}</style>
