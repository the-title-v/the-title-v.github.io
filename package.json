{
  "name": "the-title-v-direct",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4322",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "verify:build": "node --env-file-if-exists=.env.local --import tsx scripts/verify-build.mjs",
    "verify:site": "node --import tsx scripts/verify-build.mjs --structure-only",
    "verify:privacy": "node --env-file-if-exists=.env.local scripts/verify-privacy.mjs",
    "sync:availability": "node --env-file-if-exists=.env.local --import tsx scripts/sync-availability.ts",
    "publish:cloudflare": "node --env-file-if-exists=.env.local scripts/publish-cloudflare.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.7",
    "astro": "7.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
